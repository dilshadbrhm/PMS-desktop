import { useState, useEffect, useCallback } from 'react';
import { getToken } from '../api/client';
import {
  getBildirisTarixce,
  type BildirisItem,
  type BildirisSeviyye,
} from '../api/notifyClient';
import {
  connectNotifySocket,
  onYeniBildiris,
  onBildirisSilindi,
} from '../api/notifySocket';
import './NotificationsPage.css';

interface Props {
  onBack?: () => void;
}

function formatNotifyDate(dateStr?: string | null): string {
  if (!dateStr) return '';
  try {
    const d = new Date(dateStr);
    if (isNaN(d.getTime())) return dateStr;
    return d.toLocaleString('az-AZ', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    });
  } catch {
    return dateStr;
  }
}

function getSenderName(gonderen?: BildirisItem['gonderen']): string {
  if (!gonderen) return 'Sistem';
  if (typeof gonderen === 'string') return gonderen;
  return gonderen.adSoyad || gonderen.name || 'Sistem';
}

function getSeviyyeLabel(seviyye: BildirisSeviyye): string {
  switch (seviyye) {
    case 'vacib':
      return 'Vacib';
    case 'cox_vacib':
      return 'Çox Vacib';
    case 'adi':
    default:
      return 'Adi';
  }
}

export default function NotificationsPage({ }: Props) {
  const [items, setItems] = useState<BildirisItem[]>([]);
  const [loading, setLoading] = useState<boolean>(true);
  const [error, setError] = useState<string>('');

  // Test paneli state-leri
  const [testMesaj, setTestMesaj] = useState<string>('')
  const [testSeviyye, setTestSeviyye] = useState<BildirisSeviyye>('adi')
  const [testGonderiyor, setTestGonderiyor] = useState<boolean>(false)
  const [testNetice, setTestNetice] = useState<{ ok: boolean; mesaj: string } | null>(null)

  // 1. Adi bildiriş: sadə toast
  const [toasts, setToasts] = useState<{ id: string | number; title: string; msg: string }[]>([]);

  // 2. Vacib bildiriş: mərkəzdə modal
  const [vacibModal, setVacibModal] = useState<BildirisItem | null>(null);

  // 3. Çox vacib bildiriş: tam ekran qırmızı overlay
  const [coxVacibOverlay, setCoxVacibOverlay] = useState<BildirisItem | null>(null);

  // Tarixçəni yüklə
  const loadHistory = useCallback(async () => {
    setLoading(true);
    setError('');
    try {
      const data = await getBildirisTarixce();
      console.log('[NotificationsPage] Tarixçə alındı:', data);
      setItems(Array.isArray(data) ? data : []);
    } catch (err: unknown) {
      console.error('[NotificationsPage] Yükləmə xətası:', err);
      setError(err instanceof Error ? err.message : 'Bildirişləri yükləmək mümkün olmadı');
    } finally {
      setLoading(false);
    }
  }, []);

  // Socket və dinləyicilərin qurulması
  useEffect(() => {
    const token = getToken();
    if (token) {
      connectNotifySocket(token);
    }

    loadHistory();

    // Yeni bildiriş hadisəsi
    const unsubYeni = onYeniBildiris((yeni: BildirisItem) => {
      console.log('[NotificationsPage] Yeni bildiriş gəldi:', yeni);

      // Siyahının başına əlavə et
      setItems(prev => [yeni, ...prev]);

      // Səviyyəyə görə fərqli görünüş göstər
      if (yeni.seviyye === 'cox_vacib') {
        setCoxVacibOverlay(yeni);
      } else if (yeni.seviyye === 'vacib') {
        setVacibModal(yeni);
      } else {
        // Adi: sadə toast
        const toastId = yeni.id || Date.now();
        setToasts(prev => [
          ...prev,
          {
            id: toastId,
            title: getSenderName(yeni.gonderen),
            msg: yeni.mesaj,
          },
        ]);

        // 5 saniyə sonra avtomatik sil
        setTimeout(() => {
          setToasts(prev => prev.filter(t => t.id !== toastId));
        }, 5000);
      }
    });

    // Bildiriş silindi hadisəsi
    const unsubSil = onBildirisSilindi(({ id }) => {
      console.log('[NotificationsPage] Bildiriş silindi ID:', id);
      setItems(prev => prev.filter(item => String(item.id) !== String(id)));
    });

    return () => {
      unsubYeni();
      unsubSil();
    };
  }, [loadHistory]);

  return (
    <div className="np-root">
      <div className="np-blob np-blob--1" />
      <div className="np-blob np-blob--2" />

      {/* Header */}
      <header className="np-header">
        <div className="np-header-left">
          <div className="np-title-group">
            <h1 className="np-title">Bildirişlər</h1>
            <p className="np-subtitle">
              Sistem və idarəetmə bildirişlərinin tarixçəsi
            </p>
          </div>
        </div>

        <div className="np-header-right">
          <button
            type="button"
            className="np-refresh-btn"
            onClick={loadHistory}
            disabled={loading}
            title="Yenilə"
          >
            <svg
              className={loading ? 'np-spin' : ''}
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
            >
              <polyline points="23 4 23 10 17 10" />
              <polyline points="1 20 1 14 7 14" />
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
            </svg>
            Yenilə
          </button>
        </div>
      </header>

      {/* Yüklənir */}
      {loading && (
        <div className="np-state-center">
          <div className="np-spinner" />
          <p className="np-state-text">Bildirişlər yüklənir...</p>
        </div>
      )}

      {/* Xəta */}
      {!loading && error && (
        <div className="np-state-center np-error-box">
          <h3 className="np-error-title">Xəta baş verdi</h3>
          <p className="np-error-msg">{error}</p>
          <button type="button" className="np-retry-btn" onClick={loadHistory}>
            Yenidən cəhd et
          </button>
        </div>
      )}

      {/* Boş */}
      {!loading && !error && items.length === 0 && (
        <div className="np-state-center">
          <svg
            width="44"
            height="44"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#475569"
            strokeWidth="1.8"
            strokeLinecap="round"
            strokeLinejoin="round"
          >
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
          </svg>
          <p className="np-state-text">Hələ heç bir bildiriş yoxdur</p>
        </div>
      )}

      {/* Siyahı */}
      {!loading && !error && items.length > 0 && (
        <div className="np-list-container">
          {items.map(item => {
            const seviyye: BildirisSeviyye = item.seviyye || 'adi';
            const dateDisplay = formatNotifyDate(item.tarix || item.created_at);

            return (
              <div key={item.id} className={`np-item np-item--${seviyye}`}>
                <div className="np-item-icon">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="2"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  >
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                    <path d="M13.73 21a2 2 0 0 1-3.46 0" />
                  </svg>
                </div>

                <div className="np-item-body">
                  <div className="np-item-header">
                    <span className="np-item-sender">{getSenderName(item.gonderen)}</span>
                    <span className={`np-item-badge np-badge--${seviyye}`}>
                      {getSeviyyeLabel(seviyye)}
                    </span>
                  </div>
                  <p className="np-item-msg">{item.mesaj}</p>
                  {dateDisplay && <span className="np-item-time">{dateDisplay}</span>}
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* ── 1. Adi Bildiriş Toastları ── */}
      {toasts.length > 0 && (
        <div className="np-toast-container">
          {toasts.map(toast => (
            <div key={toast.id} className="np-toast">
              <div className="np-toast-content">
                <div className="np-toast-title">{toast.title}</div>
                <p className="np-toast-msg">{toast.msg}</p>
              </div>
              <button
                type="button"
                className="np-toast-close"
                onClick={() => setToasts(prev => prev.filter(t => t.id !== toast.id))}
              >
                ×
              </button>
            </div>
          ))}
        </div>
      )}

      {/* ── 2. Vacib Bildiriş Modalı ── */}
      {vacibModal && (
        <div className="np-modal-overlay" onClick={() => setVacibModal(null)}>
          <div className="np-modal" onClick={e => e.stopPropagation()}>
            <div className="np-modal-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
            </div>
            <h3 className="np-modal-title">Vacib Bildiriş</h3>
            <p className="np-modal-msg">{vacibModal.mesaj}</p>
            <button
              type="button"
              className="np-modal-btn"
              onClick={() => setVacibModal(null)}
            >
              Oldu, anladım
            </button>
          </div>
        </div>
      )}

      {/* ── 3. Çox Vacib Bildiriş: Tam Ekran Qırmızı Overlay ── */}
      {coxVacibOverlay && (
        <div className="np-fullscreen-overlay">
          <div className="np-fullscreen-card">
            <div className="np-fullscreen-icon">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                <line x1="12" y1="9" x2="12" y2="13" />
                <line x1="12" y1="17" x2="12.01" y2="17" />
              </svg>
            </div>
            <h2 className="np-fullscreen-title">TƏCİLİ / ÇOX VACİB BİLDİRİŞ</h2>
            <p className="np-fullscreen-msg">{coxVacibOverlay.mesaj}</p>
            <button
              type="button"
              className="np-fullscreen-btn"
              onClick={() => setCoxVacibOverlay(null)}
            >
              Oxudum və Təsdiq edirəm
            </button>
          </div>
        </div>
      )}
    </div>
  );
}


